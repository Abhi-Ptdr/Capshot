; TS 7 is newer than @typescript-eslint/parser@8.71.1's declared peer range
; (peer caps at typescript <6.1.0). Eslint runs independently of tsc/vite, so
; the stale peer range is cosmetic — enable legacy-peer-deps so install
; succeeds without --force. Revert when @typescript-eslint ships TS7 support.
legacy-peer-deps=true
